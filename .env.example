# ==============================================================================
# Monorepo Root Environment Configuration Template (.env.example)
# Copy this file to root .env when running multi-service Docker Compose
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration (React 18 + Vite)
# Note: Browser executes on host machine, so localhost:3000/api is used.
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# Backend API Gateway Configuration (NestJS)
# ------------------------------------------------------------------------------
PORT=3000
# For local Docker: mongodb://mongodb:27017/ocr_ai
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/ocr_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongodb:27017/ocr_ai
AI_SERVICE_URL=http://ai-service:8000
FRONTEND_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary CDN Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Upload & File Limits
MAX_IMAGE_SIZE_MB=10

# ------------------------------------------------------------------------------
# AI Microservice Configuration (FastAPI)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
AI_SERVICE_PORT=8000

# Google Gemini Vision API (Optional - falls back to Local Grounded Synthesizer if empty)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
