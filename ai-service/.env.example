# AI Service Configuration
PORT=8000
HOST=0.0.0.0

# Gemini Multimodal Vision API (Optional - falls back to Local Grounded Synthesizer if empty)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Image Processing
MAX_IMAGE_SIZE_MB=10

# Note: Cloudinary credentials (CLOUDINARY_*) are NOT_REQUIRED_BY_AI_SERVICE
# (Images are downloaded directly via standard HTTPS URLs provided by the Gateway)
